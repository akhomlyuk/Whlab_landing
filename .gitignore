# на диске, в репозиторий не попадают.
docs/
.superpowers/

# Изолированные рабочие копии для веток.
.worktrees/

# Скомпилированный Python. Репозиторий без сборки, и кэш модулей — не его
# часть: он меняется от запуска к запуску и попадает в коммит случайно.
__pycache__/
*.pyc
